BRAIN_PORT=4317
BRAIN_HOST=127.0.0.1
BRAIN_VERSION=0.1.0
BRAIN_AI_PROVIDER=fake
BRAIN_DATA_DIR=./data/brain

# OpenAI/Codex Subscription Provider bridge. Requires `codex login` on the host.
# BRAIN_AI_PROVIDER=openai-codex
# BRAIN_CODEX_COMMAND=codex
# BRAIN_CODEX_ARGS=exec
# BRAIN_CODEX_TIMEOUT_MS=120000

# Optional. When unset, System Issues are recorded locally without Discord delivery.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
