# Linux user that owns the Raspberry Pi graphical session.
KIOSK_USER=pi

# Device UI URL served by the local Device UI app.
DEVICE_UI_URL=http://127.0.0.1:3000

# Brain Server URLs reachable from the Raspberry Pi.
BRAIN_HTTP_URL=http://127.0.0.1:4317
BRAIN_WS_URL=ws://127.0.0.1:4317

# Raspberry Pi OS commonly provides chromium-browser. Use chromium if your image does.
CHROMIUM_BINARY=chromium-browser

# X11 display for the kiosk session.
KIOSK_DISPLAY=:0
